{
    "comments": {
        "lineComment": "--",
        "blockComment": [
            "/*",
            "*/"
        ]
    },
    "brackets": [
        [
            "(",
            ")"
        ],
        [
            "BEGIN",
            "END"
        ],
        [
            "CASE",
            "END"
        ],
        [
            "LOOP",
            "END LOOP"
        ],
        [
            "IF",
            "END IF"
        ]
    ],
    "autoClosingPairs": [
        {
            "open": "(",
            "close": ")"
        },
        {
            "open": "'",
            "close": "'",
            "notIn": [
                "string"
            ]
        },
        {
            "open": "\"",
            "close": "\"",
            "notIn": [
                "string"
            ]
        },
        {
            "open": "/*",
            "close": "*/"
        }
    ],
    "surroundingPairs": [
        [
            "(",
            ")"
        ],
        [
            "'",
            "'"
        ],
        [
            "\"",
            "\""
        ]
    ],
    "folding": {
        "markers": {
            "start": "^\\s*(BEGIN|DECLARE|CREATE|CASE|IF|LOOP|FOR|WHILE)",
            "end": "^\\s*(END;?|END\\s+IF;?|END\\s+LOOP;?|END\\s+CASE;?)"
        }
    }
}