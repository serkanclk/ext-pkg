{
  "name": "ing-sql",
  "displayName": "ING SQL",
  "description": "Oracle SQL Developer for VS Code (ING Specific)",
  "version": "2.1.2",
  "publisher": "ing-sql",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ingSql",
          "title": "ING SQL",
          "icon": "resources/icons/ing-sql.svg"
        }
      ],
      "panel": [
        {
          "id": "ingSqlPanel",
          "title": "ING SQL",
          "icon": "$(database)"
        }
      ]
    },
    "views": {
      "ingSql": [
        {
          "id": "ingSql.objectBrowser",
          "name": "Object Browser",
          "icon": "resources/icons/database.svg"
        },
        {
          "id": "ingSql.sqlHistory",
          "name": "SQL History",
          "icon": "$(history)"
        },
        {
          "id": "ingSql.snippets",
          "name": "SQL Snippets",
          "icon": "$(symbol-field)"
        }
      ],
      "ingSqlPanel": [
        {
          "type": "webview",
          "id": "ingSql.resultsView",
          "name": "Query Results",
          "contextualTitle": "Query Results",
          "icon": "$(output)"
        }
      ]
    },
    "commands": [
      {
        "command": "ingSql.addConnection",
        "title": "Add Connection",
        "category": "Oracle",
        "icon": "$(add)"
      },
      {
        "command": "ingSql.removeConnection",
        "title": "Remove Connection",
        "category": "Oracle",
        "icon": "$(trash)"
      },
      {
        "command": "ingSql.editConnection",
        "title": "Edit Connection",
        "category": "Oracle",
        "icon": "$(edit)"
      },
      {
        "command": "ingSql.connect",
        "title": "Connect",
        "category": "Oracle",
        "icon": "$(plug)"
      },
      {
        "command": "ingSql.disconnect",
        "title": "Disconnect",
        "category": "Oracle",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "ingSql.testConnection",
        "title": "Test Connection",
        "category": "Oracle"
      },
      {
        "command": "ingSql.newSqlWorksheet",
        "title": "New SQL Worksheet",
        "category": "Oracle",
        "icon": "$(new-file)"
      },
      {
        "command": "ingSql.executeQuery",
        "title": "Execute Statement",
        "category": "Oracle",
        "icon": "$(play)"
      },
      {
        "command": "ingSql.executeScript",
        "title": "Execute Script",
        "category": "Oracle",
        "icon": "$(run-all)"
      },
      {
        "command": "ingSql.executeExplainPlan",
        "title": "Explain Plan",
        "category": "Oracle",
        "icon": "$(graph)"
      },
      {
        "command": "ingSql.openData",
        "title": "Open Data",
        "category": "Oracle",
        "icon": "$(table)"
      },
      {
        "command": "ingSql.describeObject",
        "title": "Describe",
        "category": "Oracle",
        "icon": "$(info)"
      },
      {
        "command": "ingSql.importData",
        "title": "Import Data",
        "category": "Oracle",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "ingSql.toUpperCase",
        "title": "Uppercase Selection (SQL-Aware)",
        "category": "Oracle",
        "icon": "$(case-sensitive)"
      },
      {
        "command": "ingSql.toLowerCase",
        "title": "Lowercase Selection (SQL-Aware)",
        "category": "Oracle",
        "icon": "$(case-sensitive)"
      },
      {
        "command": "ingSql.describeObjectAtCursor",
        "title": "Describe Object at Cursor",
        "category": "Oracle",
        "icon": "$(info)"
      },
      {
        "command": "ingSql.showSqlHistory",
        "title": "Show SQL History",
        "category": "Oracle",
        "icon": "$(history)"
      },
      {
        "command": "ingSql.generateSelect",
        "title": "Generate SELECT Statement",
        "category": "Oracle"
      },
      {
        "command": "ingSql.refreshObjectBrowser",
        "title": "Refresh",
        "category": "Oracle",
        "icon": "$(refresh)"
      },
      {
        "command": "ingSql.compileObject",
        "title": "Compile",
        "category": "Oracle",
        "icon": "$(gear)"
      },
      {
        "command": "ingSql.dropObject",
        "title": "Drop",
        "category": "Oracle",
        "icon": "$(trash)"
      },
      {
        "command": "ingSql.viewSource",
        "title": "View Source",
        "category": "Oracle",
        "icon": "$(code)"
      },
      {
        "command": "ingSql.clearSqlHistory",
        "title": "Clear SQL History",
        "category": "Oracle",
        "icon": "$(clear-all)"
      },
      {
        "command": "ingSql.verifyThickMode",
        "title": "Verify Oracle Client (Thick Mode)",
        "category": "Oracle"
      },
      {
        "command": "ingSql.about",
        "title": "About ING SQL",
        "category": "Oracle"
      },
      {
        "command": "ingSql.searchObjects",
        "title": "Search Objects",
        "category": "Oracle",
        "icon": "$(search)"
      },
      {
        "command": "ingSql.addSnippet",
        "title": "Add Snippet",
        "category": "Oracle",
        "icon": "$(add)"
      },
      {
        "command": "ingSql.editSnippet",
        "title": "Edit Snippet",
        "category": "Oracle",
        "icon": "$(edit)"
      },
      {
        "command": "ingSql.deleteSnippet",
        "title": "Delete Snippet",
        "category": "Oracle",
        "icon": "$(trash)"
      },
      {
        "command": "ingSql.insertSnippet",
        "title": "Insert Snippet",
        "category": "Oracle",
        "icon": "$(symbol-field)"
      },
      {
        "command": "ingSql.refreshSnippets",
        "title": "Refresh Snippets",
        "category": "Oracle",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ingSql.addConnection",
          "when": "view == ingSql.objectBrowser",
          "group": "navigation@1"
        },
        {
          "command": "ingSql.refreshObjectBrowser",
          "when": "view == ingSql.objectBrowser",
          "group": "navigation@2"
        },
        {
          "command": "ingSql.newSqlWorksheet",
          "when": "view == ingSql.objectBrowser",
          "group": "navigation@3"
        },
        {
          "command": "ingSql.clearSqlHistory",
          "when": "view == ingSql.sqlHistory",
          "group": "navigation"
        },
        {
          "command": "ingSql.searchObjects",
          "when": "view == ingSql.objectBrowser",
          "group": "navigation@0"
        },
        {
          "command": "ingSql.addSnippet",
          "when": "view == ingSql.snippets",
          "group": "navigation@1"
        },
        {
          "command": "ingSql.refreshSnippets",
          "when": "view == ingSql.snippets",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "ingSql.insertSnippet",
          "when": "view == ingSql.snippets && viewItem == sql-snippet",
          "group": "inline@1"
        },
        {
          "command": "ingSql.editSnippet",
          "when": "view == ingSql.snippets && viewItem == sql-snippet",
          "group": "snippet@1"
        },
        {
          "command": "ingSql.deleteSnippet",
          "when": "view == ingSql.snippets && viewItem == sql-snippet",
          "group": "snippet@2"
        },
        {
          "command": "ingSql.importData",
          "when": "view == ingSql.objectBrowser && viewItem == connection-connected",
          "group": "inline@3"
        },
        {
          "command": "ingSql.connect",
          "when": "view == ingSql.objectBrowser && viewItem == connection-disconnected",
          "group": "inline@1"
        },
        {
          "command": "ingSql.disconnect",
          "when": "view == ingSql.objectBrowser && viewItem == connection-connected",
          "group": "inline@1"
        },
        {
          "command": "ingSql.newSqlWorksheet",
          "when": "view == ingSql.objectBrowser && viewItem == connection-connected",
          "group": "inline@2"
        },
        {
          "command": "ingSql.newSqlWorksheet",
          "when": "view == ingSql.objectBrowser && viewItem =~ /^(connection-connected|category|table|view|mview|index|sequence|synonym|dblink|trigger|procedure|function|package|type|column|constraint|grant|table-trigger|table-index)$/",
          "group": "worksheet@1"
        },
        {
          "command": "ingSql.editConnection",
          "when": "view == ingSql.objectBrowser && viewItem =~ /^connection/",
          "group": "connection@1"
        },
        {
          "command": "ingSql.removeConnection",
          "when": "view == ingSql.objectBrowser && viewItem =~ /^connection/",
          "group": "connection@2"
        },
        {
          "command": "ingSql.testConnection",
          "when": "view == ingSql.objectBrowser && viewItem =~ /^connection/",
          "group": "connection@3"
        },
        {
          "command": "ingSql.openData",
          "when": "view == ingSql.objectBrowser && viewItem =~ /^(table|view|mview)$/",
          "group": "data@1"
        },
        {
          "command": "ingSql.importData",
          "when": "view == ingSql.objectBrowser && viewItem == table",
          "group": "data@2"
        },
        {
          "command": "ingSql.describeObject",
          "when": "view == ingSql.objectBrowser && viewItem =~ /^(table|view|mview|index|sequence|synonym|dblink|trigger)$/",
          "group": "info@1"
        },
        {
          "command": "ingSql.generateSelect",
          "when": "view == ingSql.objectBrowser && viewItem =~ /^(table|view|mview)$/",
          "group": "info@2"
        },
        {
          "command": "ingSql.viewSource",
          "when": "view == ingSql.objectBrowser && viewItem =~ /^(procedure|function|package|trigger|type)$/",
          "group": "code@1"
        },
        {
          "command": "ingSql.compileObject",
          "when": "view == ingSql.objectBrowser && viewItem =~ /^(procedure|function|package|trigger|type)$/",
          "group": "code@2"
        },
        {
          "command": "ingSql.dropObject",
          "when": "view == ingSql.objectBrowser && viewItem =~ /^(table|view|mview|index|sequence|procedure|function|package|trigger|type|synonym|dblink)$/",
          "group": "danger@1"
        }
      ],
      "editor/title": [
        {
          "command": "ingSql.executeQuery",
          "when": "resourceLangId == oraclesql",
          "group": "navigation@1"
        },
        {
          "command": "ingSql.executeScript",
          "when": "resourceLangId == oraclesql",
          "group": "navigation@2"
        },
        {
          "command": "ingSql.executeExplainPlan",
          "when": "resourceLangId == oraclesql",
          "group": "navigation@3"
        }
      ]
    },
    "languages": [
      {
        "id": "oraclesql",
        "aliases": [
          "Oracle SQL",
          "oraclesql",
          "plsql"
        ],
        "extensions": [
          ".sql",
          ".osql",
          ".plsql",
          ".pls",
          ".pck"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "oraclesql",
        "scopeName": "source.oraclesql",
        "path": "./syntaxes/oraclesql.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "ING SQL",
      "properties": {
        "ingSql.nls.language": {
          "type": "string",
          "default": "AMERICAN",
          "description": "Oracle NLS_LANGUAGE setting",
          "enum": [
            "AMERICAN",
            "TURKISH",
            "ENGLISH",
            "GERMAN",
            "FRENCH"
          ],
          "enumDescriptions": [
            "American English",
            "Turkish",
            "English",
            "German",
            "French"
          ]
        },
        "ingSql.nls.territory": {
          "type": "string",
          "default": "AMERICA",
          "description": "Oracle NLS_TERRITORY setting",
          "enum": [
            "AMERICA",
            "TURKEY",
            "UNITED KINGDOM",
            "GERMANY",
            "FRANCE"
          ],
          "enumDescriptions": [
            "United States",
            "Turkey",
            "United Kingdom",
            "Germany",
            "France"
          ]
        },
        "ingSql.nls.dateFormat": {
          "type": "string",
          "default": "YYYY-MM-DD HH24:MI:SS",
          "description": "Oracle NLS_DATE_FORMAT setting"
        },
        "ingSql.nls.timestampFormat": {
          "type": "string",
          "default": "YYYY-MM-DD HH24:MI:SS.FF",
          "description": "Oracle NLS_TIMESTAMP_FORMAT setting"
        },
        "ingSql.nls.timestampTzFormat": {
          "type": "string",
          "default": "YYYY-MM-DD HH24:MI:SS.FF TZR",
          "description": "Oracle NLS_TIMESTAMP_TZ_FORMAT setting"
        },
        "ingSql.connections": {
          "type": "array",
          "default": [],
          "description": "Database connections"
        },
        "ingSql.results.location": {
          "type": "string",
          "default": "editor",
          "enum": [
            "bottom",
            "editor"
          ],
          "description": "Where to display query results"
        }
      }
    },
    "keybindings": [
      {
        "command": "ingSql.executeQuery",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && resourceLangId == oraclesql"
      },
      {
        "command": "ingSql.executeScript",
        "key": "f5",
        "when": "editorTextFocus && resourceLangId == oraclesql"
      },
      {
        "command": "ingSql.newSqlWorksheet",
        "key": "alt+f10",
        "mac": "alt+f10",
        "when": "editorTextFocus && resourceLangId == oraclesql"
      },
      {
        "command": "ingSql.toUpperCase",
        "key": "ctrl+shift+u",
        "mac": "cmd+shift+u",
        "when": "editorTextFocus && resourceLangId == oraclesql"
      },
      {
        "command": "ingSql.executeExplainPlan",
        "key": "f10",
        "when": "editorTextFocus && resourceLangId == oraclesql"
      },
      {
        "command": "ingSql.toLowerCase",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l",
        "when": "editorTextFocus && resourceLangId == oraclesql"
      },
      {
        "command": "ingSql.describeObjectAtCursor",
        "key": "shift+f4",
        "when": "editorTextFocus && resourceLangId == oraclesql"
      },
      {
        "command": "ingSql.showSqlHistory",
        "key": "f8",
        "when": "editorTextFocus && resourceLangId == oraclesql"
      },
      {
        "command": "editor.action.formatDocument",
        "key": "ctrl+f7",
        "mac": "cmd+f7",
        "when": "editorTextFocus && resourceLangId == oraclesql"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "package:full": "node scripts/prepare-full.js && npx @vscode/vsce package --target darwin-arm64 --target darwin-x64 --target linux-x64",
    "package:restricted": "node scripts/prepare-restricted.js && npx @vscode/vsce package --target darwin-arm64 --target darwin-x64 --target linux-x64 && node scripts/prepare-full.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "oracledb": "^6.3.0",
    "exceljs": "^4.4.0"
  }
}